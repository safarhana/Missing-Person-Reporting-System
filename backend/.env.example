# Application & Database Configuration
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=missing_person_reporting_system

# Mailer Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="Missing Person System" <no-reply@mprsystem.com>

# Missing Person Reporter Specific Configuration
MPR_MAX_FILE_SIZE=2097152
MPR_DEFAULT_AGE=25
MPR_DEFAULT_STATUS=active
MPR_DEFAULT_EMAIL_SUBJECT=Missing Person System Alert
MPR_DEFAULT_EMAIL_MESSAGE=A missing person report update has been processed.
MPR_AGE_FILTER_THRESHOLD=40
